generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Proyek {
  id         Int      @id @default(autoincrement())
  judul      String
  thumbnail  String?
  deskripsi  String
  footer     String
  linkSitus  String
  linkGithub String
  dibuatPada DateTime @default(now())
}

model Pesan {
  id         Int      @id @default(autoincrement())
  nama       String
  email      String   @unique
  pesan      String
  dibuatPada DateTime @default(now())
}
